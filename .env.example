SERVICEFLOW_DATABASE_URL=mysql+aiomysql://serviceflow:serviceflow@localhost:33069/serviceflow
SERVICEFLOW_API_KEY=
SERVICEFLOW_BASE_URL=https://api.deepseek.com
SERVICEFLOW_MODEL=deepseek-v4-flash
SERVICEFLOW_THINKING_MODE=enabled
SERVICEFLOW_REASONING_EFFORT=high

# 下面四项仅用于本地模拟数据库，不是生产凭据。
MYSQL_DATABASE=serviceflow
MYSQL_USER=serviceflow
MYSQL_PASSWORD=serviceflow
MYSQL_ROOT_PASSWORD=serviceflow-root

# compose.yaml 会把 API 容器内的数据库地址改为 mysql:3306。
# 不要把真实 API Key 写入仓库；请只放在本机 .env 文件中。
