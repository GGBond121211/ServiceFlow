SERVICEFLOW_DATABASE_URL=mysql+aiomysql://serviceflow:serviceflow@localhost:33069/serviceflow
SERVICEFLOW_API_KEY=
SERVICEFLOW_BASE_URL=https://api.frontier-intelligence.tech/v1
SERVICEFLOW_MODEL=deepseek-v4-flash
SERVICEFLOW_MCP_TRANSPORT=stdio
SERVICEFLOW_THINKING_MODE=disabled
SERVICEFLOW_REASONING_EFFORT=
SERVICEFLOW_GATEWAY_BACKUP_MODEL=gpt-5.6-luna
SERVICEFLOW_GATEWAY_ATTEMPTS_PER_MODEL=2
SERVICEFLOW_GATEWAY_DEADLINE_S=20
SERVICEFLOW_GATEWAY_BUCKET_CAPACITY=60
SERVICEFLOW_GATEWAY_REFILL_PER_SECOND=1
SERVICEFLOW_GATEWAY_MAX_CONCURRENCY=8
SERVICEFLOW_GATEWAY_QUEUE_LIMIT=0
SERVICEFLOW_GATEWAY_INTERNAL_KEY=replace-with-a-random-local-secret
SERVICEFLOW_TRACE_SAMPLE_RATIO=1

# 2026-09-05 由用户登录 Frontier 控制台定价页核对；单位为 ◆ / 1M tokens。
SERVICEFLOW_GATEWAY_PRIMARY_INPUT_COST=12
SERVICEFLOW_GATEWAY_PRIMARY_OUTPUT_COST=36
SERVICEFLOW_GATEWAY_PRIMARY_CACHED_INPUT_COST=0.3996
SERVICEFLOW_GATEWAY_BACKUP_INPUT_COST=1.5
SERVICEFLOW_GATEWAY_BACKUP_OUTPUT_COST=12
SERVICEFLOW_GATEWAY_BACKUP_CACHED_INPUT_COST=0.18
SERVICEFLOW_REDIS_URL=redis://redis:6379/0
SERVICEFLOW_CELERY_BROKER_URL=redis://redis:6379/1
SERVICEFLOW_CELERY_RESULT_BACKEND=redis://redis:6379/2

# 009 Policy RAG 的 Embedding 配置。系统环境已有配置时可不写入项目 .env。
SERVICEFLOW_EMBEDDING_API_KEY=
SERVICEFLOW_EMBEDDING_BASE_URL=
SERVICEFLOW_EMBEDDING_MODEL=

# qwen3.7-text-rerank 使用同一阿里云业务空间的 Embedding 凭据时可省略下面两项。
# 默认关闭，避免服务启动后对每次请求产生额外模型费用；小规模验证通过后再显式设为 true。
SERVICEFLOW_RERANK_ENABLED=false
SERVICEFLOW_RERANK_API_KEY=
SERVICEFLOW_RERANK_BASE_URL=
SERVICEFLOW_RERANK_MODEL=qwen3.7-text-rerank
SERVICEFLOW_RERANK_CANDIDATE_K=10
SERVICEFLOW_RERANK_TIMEOUT_S=30
SERVICEFLOW_POLICY_DOCUMENTS_PATH=

# 下面四项仅用于本地模拟数据库，不是生产凭据。
MYSQL_DATABASE=serviceflow
MYSQL_USER=serviceflow
MYSQL_PASSWORD=serviceflow
MYSQL_ROOT_PASSWORD=serviceflow-root

# compose.yaml 会把 API 容器内的数据库地址改为 mysql:3306。
# 不要把真实 API Key 写入仓库；请只放在本机 .env 文件中。
